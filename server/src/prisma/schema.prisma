generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Family {
  id           String        @id @default(cuid())
  name         String
  createdAt    DateTime      @default(now())
  members      User[]
  sharedWallet Wallet?       @relation("SharedWallet")
  invites      FamilyInvite[]
  debts        Debt[]
  subFunds     SubFund[]
}

model FamilyInvite {
  id               String    @id @default(cuid())
  familyId         String
  inviteCode       String    @unique
  personalCodeHash String
  hint             String
  createdByUserId  String
  usedAt           DateTime?
  usedByUserId     String?
  expiresAt        DateTime
  family           Family    @relation(fields: [familyId], references: [id])
  createdAt        DateTime  @default(now())
}

model User {
  id                  String    @id @default(cuid())
  name                String
  email               String    @unique
  password            String
  role                String    @default("MEMBER")
  isAppAdmin          Boolean   @default(false)
  familyId            String?
  recoveryCodeHash    String?
  resetToken          String?
  resetTokenExpiresAt DateTime?
  tokenVersion        Int       @default(0)
  family              Family?   @relation(fields: [familyId], references: [id])
  personalWallets     Wallet[]  @relation("PersonalWallet")
  exchangeRates       ExchangeRate[]
  transactions        Transaction[]
  settlementsFrom     Settlement[]   @relation("SettlementFrom")
  settlementsTo       Settlement[]   @relation("SettlementTo")
  ownedDebts           Debt[]         @relation("DebtOwner")
  lentDebts            Debt[]         @relation("DebtLender")
  borrowedDebts        Debt[]         @relation("DebtBorrower")
  debtViewAccess       DebtViewer[]
  debtPayments         DebtPayment[]
  recurrings           RecurringTransaction[]
  savingsGoals         SavingsGoal[]
  categories           Category[]
  weeklyBudgets        WeeklyBudget[]
  planItems            PlanItem[]
  subFundMembers       SubFundMember[]
  savingsContribs      SavingsContribution[]
  huis                 Hui[]
  withdrawalRequests   SavingsWithdrawalRequest[]  @relation("WithdrawalRequester")
  withdrawalApprovals  SavingsWithdrawalApproval[]
  recipientLabels      RecipientLabel[]
  monthlyBudgets       MonthlyBudget[]
  createdAt           DateTime  @default(now())
}

model Wallet {
  id             String        @id @default(cuid())
  type           String
  userId         String?
  familyId       String?       @unique
  subFundId      String?       @unique
  initialBalance Float         @default(0)
  currency       String        @default("VND")
  name           String?
  user           User?         @relation("PersonalWallet", fields: [userId], references: [id])
  family         Family?       @relation("SharedWallet", fields: [familyId], references: [id])
  subFund        SubFund?      @relation("SubFundWallet", fields: [subFundId], references: [id])
  transactions   Transaction[]
  debts          Debt[]
  pockets        WalletPocket[]
  huis           Hui[]
  closedAt       DateTime?
  createdAt      DateTime      @default(now())

  @@index([userId])
}

model ExchangeRate {
  id           String   @id @default(cuid())
  userId       String
  fromCurrency String
  toCurrency   String
  rate         Float
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  updatedAt    DateTime @updatedAt

  @@unique([userId, fromCurrency, toCurrency])
}

model SubFund {
  id          String          @id @default(cuid())
  name        String
  icon        String          @default("🏦")
  description String?
  familyId    String
  family      Family          @relation(fields: [familyId], references: [id], onDelete: Cascade)
  wallet      Wallet?         @relation("SubFundWallet")
  members     SubFundMember[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([familyId])
}

model SubFundMember {
  id        String   @id @default(cuid())
  subFundId String
  userId    String
  role      String   @default("MEMBER") // "ADMIN" | "MEMBER"
  subFund   SubFund  @relation(fields: [subFundId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())

  @@unique([subFundId, userId])
}

model WalletPocket {
  id           String        @id @default(cuid())
  walletId     String
  name         String
  icon         String        @default("💰")
  color        String        @default("#6B7280")
  balance      Float         @default(0)
  initialBalance Float       @default(0)
  isHidden     Boolean       @default(false)
  order        Int           @default(0)
  wallet       Wallet        @relation(fields: [walletId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  entries      PocketEntry[]
  createdAt    DateTime      @default(now())

  @@index([walletId])
}

model PocketEntry {
  id        String       @id @default(cuid())
  pocketId  String
  amount    Float
  type      String       @default("DEPOSIT") // DEPOSIT | WITHDRAWAL
  note      String?
  date      DateTime
  pocket    WalletPocket @relation(fields: [pocketId], references: [id], onDelete: Cascade)
  createdAt DateTime     @default(now())

  @@index([pocketId, date])
}

model Category {
  id           String                 @id @default(cuid())
  name         String
  icon         String
  color        String
  type         String
  isDefault    Boolean                @default(false)
  keywords     String                 @default("")
  userId       String?
  user         User?                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions       Transaction[]
  recurrings         RecurringTransaction[]
  weeklyBudgets      WeeklyBudget[]
  planItems          PlanItem[]
  monthlyBudgetItems MonthlyBudgetItem[]

  @@unique([name, userId])
}

model WeeklyBudget {
  id          String   @id @default(cuid())
  userId      String
  categoryId  String
  limitAmount Float
  alertPct    Int      @default(80)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category    Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, categoryId])
}

model IdempotencyKey {
  id        String   @id @default(cuid())
  key       String   @unique
  response  String
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Transaction {
  id              String           @id @default(cuid())
  amount          Float
  type            String
  date            DateTime
  note            String?
  walletId        String
  categoryId      String
  userId          String
  pocketId             String?
  deletedAt            DateTime?
  transferGroupId      String?
  recipientLabelId     String?
  wallet               Wallet           @relation(fields: [walletId], references: [id])
  category             Category         @relation(fields: [categoryId], references: [id])
  user                 User             @relation(fields: [userId], references: [id])
  pocket               WalletPocket?    @relation(fields: [pocketId], references: [id], onDelete: SetNull)
  recipientLabel       RecipientLabel?  @relation(fields: [recipientLabelId], references: [id], onDelete: SetNull)
  logs                 TransactionLog[]
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  @@index([walletId, date, deletedAt])
  @@index([walletId, deletedAt])
}

model TransactionLog {
  id            String      @id @default(cuid())
  transactionId String
  action        String
  byUserId      String
  byUserName    String
  snapshot      String
  createdAt     DateTime    @default(now())
  transaction   Transaction @relation(fields: [transactionId], references: [id])
}

model Settlement {
  id         String   @id @default(cuid())
  fromUserId String
  toUserId   String
  amount     Float
  note       String?
  date       DateTime @default(now())
  fromUser   User     @relation("SettlementFrom", fields: [fromUserId], references: [id])
  toUser     User     @relation("SettlementTo", fields: [toUserId], references: [id])
  createdAt  DateTime @default(now())
}

// ─── Nợ & Cho vay ──────────────────────────────────────────────────────────

model Debt {
  id              String       @id @default(cuid())
  title           String
  type            String       // "BORROWED" | "LENT"
  scope           String       // "PERSONAL" | "SHARED" | "INTERNAL"
  originalAmount  Float
  remainingAmount Float
  counterparty    String       // Tên ngân hàng / người
  note            String?
  dueDate         DateTime?
  ownerId              String
  lenderUserId         String?      // Chỉ cho INTERNAL
  borrowerUserId       String?      // Chỉ cho INTERNAL
  walletId             String?
  familyId             String?
  walletTransactionId  String?      // Transaction tạo khi ghi nợ (để xóa khi undo)
  owner           User         @relation("DebtOwner",    fields: [ownerId],        references: [id])
  lender          User?        @relation("DebtLender",   fields: [lenderUserId],   references: [id], onDelete: SetNull)
  borrower        User?        @relation("DebtBorrower", fields: [borrowerUserId], references: [id], onDelete: SetNull)
  wallet          Wallet?      @relation(fields: [walletId], references: [id])
  family          Family?      @relation(fields: [familyId], references: [id])
  viewers         DebtViewer[]
  payments        DebtPayment[]
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([ownerId])
  @@index([familyId])
}

model DebtViewer {
  id     String @id @default(cuid())
  debtId String
  userId String
  debt   Debt   @relation(fields: [debtId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id])

  @@unique([debtId, userId])
}

model DebtPayment {
  id           String   @id @default(cuid())
  debtId       String
  amount       Float
  date         DateTime
  note         String?
  paidByUserId        String
  walletTransactionId String?      // Transaction tạo khi ghi thanh toán (để xóa khi undo)
  debt         Debt     @relation(fields: [debtId], references: [id], onDelete: Cascade)
  paidBy       User     @relation(fields: [paidByUserId], references: [id])
  createdAt    DateTime @default(now())
}

// ─── Giao dịch định kỳ ────────────────────────────────────────────────────

model RecurringTransaction {
  id         String                @id @default(cuid())
  title      String
  amount     Float
  type       String
  categoryId String
  walletType String
  frequency  String                // "MONTHLY" | "WEEKLY"
  dayOfMonth Int?
  dayOfWeek  Int?
  remindDays Int                   @default(3)
  ownerId    String
  familyId   String?
  isActive   Boolean               @default(true)
  nextDue    DateTime
  category   Category              @relation(fields: [categoryId], references: [id])
  owner      User                  @relation(fields: [ownerId], references: [id])
  proposals  TransactionProposal[]
  createdAt  DateTime              @default(now())

  @@index([ownerId, isActive])
}

// ─── Quỹ tiết kiệm ────────────────────────────────────────────────────────

model SavingsGoal {
  id            String                @id @default(cuid())
  name          String
  icon          String                @default("🎯")
  targetAmount  Float
  targetDate    DateTime
  savedAmount   Float                 @default(0)
  ownerId       String
  familyId      String?
  isShared      Boolean               @default(false)
  isCompleted   Boolean               @default(false)
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  owner         User                  @relation(fields: [ownerId], references: [id])
  contributions      SavingsContribution[]
  withdrawalRequests SavingsWithdrawalRequest[]

  @@index([ownerId])
}

model SavingsWithdrawalRequest {
  id            String    @id @default(cuid())
  goalId        String
  requestedById String
  amount        Float
  note          String?
  status        String    @default("PENDING") // PENDING | APPROVED | REJECTED | CANCELLED
  processedAt   DateTime?
  createdAt     DateTime  @default(now())
  goal          SavingsGoal                @relation(fields: [goalId], references: [id], onDelete: Cascade)
  requestedBy   User                       @relation("WithdrawalRequester", fields: [requestedById], references: [id])
  approvals     SavingsWithdrawalApproval[]

  @@index([goalId, status])
}

model SavingsWithdrawalApproval {
  id        String   @id @default(cuid())
  requestId String
  userId    String
  approved  Boolean
  createdAt DateTime @default(now())
  request   SavingsWithdrawalRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  user      User                     @relation(fields: [userId], references: [id])

  @@unique([requestId, userId])
}

model SavingsContribution {
  id        String      @id @default(cuid())
  goalId    String
  userId    String
  amount    Float
  type      String      @default("DEPOSIT") // "DEPOSIT" | "WITHDRAWAL"
  note      String?
  date      DateTime
  createdAt DateTime    @default(now())
  goal      SavingsGoal @relation(fields: [goalId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id])

  @@index([goalId])
}

// ─── Dự thu / Dự chi ────────────────────────────────────────────────────────

model PlanItem {
  id          String           @id @default(cuid())
  title       String
  amount      Float
  type        String           // "INCOME" | "EXPENSE"
  categoryId  String?
  note        String?
  frequency   String           // "ONCE" | "MONTHLY" | "WEEKLY"
  dueDay      Int?             // 1–31 cho MONTHLY; 0–6 cho WEEKLY (0=CN)
  dueDate     DateTime?        // Chỉ dùng cho ONCE
  remindDays  Int              @default(3)
  isActive    Boolean          @default(true)
  userId      String
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  category    Category?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  completions PlanCompletion[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([userId, isActive])
}

model PlanCompletion {
  id         String   @id @default(cuid())
  planItemId String
  periodKey  String   // "2025-05" monthly, "2025-W20" weekly, "2025-05-15" once
  isDone     Boolean  @default(false)
  doneAt     DateTime?
  planItem   PlanItem @relation(fields: [planItemId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([planItemId, periodKey])
}

// ─── Hụi (Rotating savings club) ─────────────────────────────────────────────

model Hui {
  id           String     @id @default(cuid())
  name         String
  amount       Float
  totalRounds  Int
  myRounds     String    @default("[]")
  startDate    DateTime
  frequency    String     @default("MONTHLY") // "MONTHLY" | "WEEKLY"
  status       String     @default("ACTIVE")  // "ACTIVE" | "COMPLETED"
  organizerFee Float?     // tiền công thảo hụi, áp dụng khi hốt kỳ 1
  walletId     String?    // ví đồng bộ tiền đóng/hốt
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  wallet       Wallet?    @relation(fields: [walletId], references: [id], onDelete: SetNull)
  rounds       HuiRound[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([userId])
}

model HuiRound {
  id                  String    @id @default(cuid())
  huiId               String
  roundNo             Int
  ownerName           String?
  dueDate             DateTime
  bidAmount           Float?
  isPaid              Boolean   @default(false)
  isReceived          Boolean   @default(false)
  paidAt              DateTime?
  walletTransactionId String?   // transaction tạo khi đóng/hốt (để xóa khi undo)
  hui                 Hui       @relation(fields: [huiId], references: [id], onDelete: Cascade)
  createdAt           DateTime  @default(now())

  @@unique([huiId, roundNo])
}

model TransactionProposal {
  id               String               @id @default(cuid())
  recurringId      String
  amount           Float
  type             String
  categoryId       String
  walletType       String
  scheduledDate    DateTime
  confirmationCode String               // 4 chữ số, lưu plain (UX friction, không phải mật khẩu)
  status           String               @default("PENDING") // "PENDING" | "CONFIRMED" | "DISMISSED"
  expiresAt        DateTime
  confirmedAt      DateTime?
  recurring        RecurringTransaction @relation(fields: [recurringId], references: [id], onDelete: Cascade)
  createdAt        DateTime             @default(now())

  @@unique([recurringId, scheduledDate])
  @@index([recurringId, status])
}

// ─── Nhãn người nhận ──────────────────────────────────────────────────────────

model RecipientLabel {
  id                 String              @id @default(cuid())
  name               String
  icon               String              @default("👤")
  color              String              @default("#6B7280")
  userId             String
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions       Transaction[]
  monthlyBudgetItems MonthlyBudgetItem[]
  createdAt          DateTime            @default(now())

  @@unique([name, userId])
  @@index([userId])
}

// ─── Ngân sách tháng ──────────────────────────────────────────────────────────

model MonthlyBudget {
  id        String              @id @default(cuid())
  userId    String
  month     String              // "2026-05" (YYYY-MM)
  amount    Float               // tổng ngân sách tháng
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     MonthlyBudgetItem[]
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  @@unique([userId, month])
  @@index([userId])
}

model MonthlyBudgetItem {
  id               String          @id @default(cuid())
  budgetId         String
  categoryId       String?
  recipientLabelId String?
  amount           Float
  budget           MonthlyBudget   @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  category         Category?       @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  recipientLabel   RecipientLabel? @relation(fields: [recipientLabelId], references: [id], onDelete: Cascade)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([budgetId])
}
